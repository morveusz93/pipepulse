# Copy to .env and adjust. Never commit .env.

# Your GitLab instance and an access token with the read_api scope
# (GitLab: Edit profile -> Access tokens; full "api" works but isn't needed).
PIPEPULSE_GITLAB_URL=https://gitlab.com
PIPEPULSE_GITLAB_TOKEN=

# Optional. Empty = every project the token can see pipelines of. To pick projects instead,
# list their paths as in the GitLab URL, i.e. gitlab.com/<this part> (e.g. my-team/backend or
# my-team/sub-group/frontend), separated by commas, spaces or newlines. Projects you drop stop
# being polled; their history stays until you delete them on the dashboard.
PIPEPULSE_PROJECTS=

PIPEPULSE_POLL_INTERVAL_SECONDS=120
