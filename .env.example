# Copy to .env and adjust. Never commit .env.

# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIPEPULSE_ENCRYPTION_KEY=

# true = public demo: seed data only, connecting real GitLab tokens is disabled
PIPEPULSE_DEMO_MODE=true

# Self-hosted mode (PIPEPULSE_DEMO_MODE=false): the admin password for managing GitLab
# connections. Admin login also needs PIPEPULSE_ENCRYPTION_KEY (it signs the session cookie).
PIPEPULSE_ADMIN_PASSWORD=
PIPEPULSE_POLL_INTERVAL_SECONDS=120
